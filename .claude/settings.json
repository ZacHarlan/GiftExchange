{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [

    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)",
      "Bash(bash harden-github.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-destructive-commands.sh"
          }
        ]
      }
    ]
  }
}
