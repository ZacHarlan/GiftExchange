#!/usr/bin/env bash
# pre-push — the last local gate before work leaves the machine.
#
# pre-commit cannot catch any of this: pushing is not committing. This hook is
# what actually stands between an agent and a protected branch.
#
# Install:
#   ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#   chmod +x scripts/hooks/pre-push
#
# git passes "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on stdin.

set -uo pipefail

PROTECTED_RE='^refs/heads/(main|master|trunk|develop|release/.*|prod|production)$'
ZERO='0000000000000000000000000000000000000000'
EXIT=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue

  if [[ "$remote_ref" =~ $PROTECTED_RE ]]; then
    branch="${remote_ref#refs/heads/}"

    if [[ "$local_sha" == "$ZERO" ]]; then
      echo "[pre-push] BLOCKED — refusing to delete protected branch '$branch'." >&2
      EXIT=1
      continue
    fi

    echo "[pre-push] BLOCKED — direct push to protected branch '$branch'." >&2
    echo "" >&2
    echo "  Protected branches change only through a reviewed pull request." >&2
    echo "  Do this instead:" >&2
    echo "    git switch -c feat/<slug>" >&2
    echo "    git push -u origin feat/<slug>" >&2
    echo "    gh pr create --fill" >&2
    EXIT=1
    continue
  fi

  # Non-fast-forward (i.e. a force-push) on any branch someone else may share.
  if [[ "$remote_sha" != "$ZERO" && "$local_sha" != "$ZERO" ]]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "[pre-push] BLOCKED — non-fast-forward push to ${remote_ref#refs/heads/}." >&2
      echo "  This rewrites history others may have pulled. Get a human to confirm." >&2
      EXIT=1
    fi
  fi
done

if (( EXIT != 0 )); then
  echo "" >&2
  echo "[pre-push] Do NOT retry with --no-verify. If you believe this is wrong," >&2
  echo "           stop and ask a human." >&2
fi

exit "$EXIT"
